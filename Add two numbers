/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* addTwoNumbers(ListNode* l1, ListNode* l2) {
     // Create a dummy node to help build the result list
        ListNode* dummy = new ListNode(0);

        // current points to the last node in our result list
        ListNode* current = dummy;

        // Carry stores the extra digit from addition
        int carry = 0;

        // Continue while either list has nodes or we have a carry
        while (l1 != nullptr || l2 != nullptr || carry != 0) {

            // Get the value of l1, or 0 if l1 is exhausted
            int x = (l1 != nullptr) ? l1->val : 0;

            // Get the value of l2, or 0 if l2 is exhausted
            int y = (l2 != nullptr) ? l2->val : 0;

            // Add both digits and the carry from the previous step
            int sum = x + y + carry;

            // The new digit is the remainder after dividing by 10
            carry = sum / 10;

            // Create a new node containing the current digit
            current->next = new ListNode(sum % 10);

            // Move current to the newly created node
            current = current->next;

            // Move l1 forward if it still has a node
            if (l1 != nullptr) {
                l1 = l1->next;
            }

            // Move l2 forward if it still has a node
            if (l2 != nullptr) {
                l2 = l2->next;
            }
        }

        // The dummy node is not part of the answer
        return dummy->next;
    }   
    
};
