class Solution {
public:
    int maximumLength(vector<int>& nums) {
       map<long long, int> freq;

        for (int num : nums) {
            freq[num]++;
        }

        int ans = 1;

        // Handle the number 1
        if (freq[1] >= 3) {
            ans = freq[1];

            if (ans % 2 == 0) {
                ans--;
            }
        }

        // Handle numbers other than 1
        for (auto [num, count] : freq) {
            if (num == 1) continue;

            long long cur = num;
            int len = 1;

            while (freq[cur] >= 2 && cur <= 1000000000LL && freq[cur * cur] >= 1) {
                len += 2;
                cur = cur * cur;
            }

            ans = max(ans, len);
        }

        return ans;
    
    }
};
